#!/bin/bash
set -e
URL=$1
RESULT_PATH=/srv/guix_result

URL_PROTOCOL="https://"
URL_WITHOUT_PROTOCOL=$(echo "$URL" | sed "s#^$URL_PROTOCOL##")
URL_DOMAIN=$(echo "$URL_WITHOUT_PROTOCOL" | cut -d '/' -f 1)
URL_PATH_PARTS=$(echo "$URL_WITHOUT_PROTOCOL" | cut -d '/' -f 2-)
URL_REPO_CORE=$(echo "$URL_PATH_PARTS" | cut -d '/' -f 1,2 | sed 's#/$##')
REPO=$(echo $URL_REPO_CORE | cut -d '/' -f 2 | sed 's/\.git$//')
REPO_URL="${URL_PROTOCOL}${URL_DOMAIN}/${URL_REPO_CORE}"

retry() {
    local max_attempts=$1; shift
    local sleep_seconds=$1; shift
    local n=1

    while (( n <= max_attempts )); do
        if "$@"; then
            return 0
        fi
        echo "Attempt $n failed. Retrying in $sleep_seconds seconds..." >&2
        ((n++))
        sleep "$sleep_seconds"
    done

    echo "Command failed after $max_attempts attempts: $*" >&2
    return 1
}


if [[ "$URL" =~ /(pull)/([0-9]+) ]]; then
    echo "类型: ${BASH_REMATCH[1]}"
    echo "ID: ${BASH_REMATCH[2]}"
    fetch_ref="pull/${BASH_REMATCH[2]}/head"
elif [[ "$URL" =~ /(commit)/([0-9a-f]+) ]]; then
    echo "类型: ${BASH_REMATCH[1]}"
    echo "哈希值: ${BASH_REMATCH[2]}"
    fetch_ref="${BASH_REMATCH[2]}"
else
    echo "pull/commit未匹配到有效信息"
    exit 1
fi
if [[ "${REPO}" == "rvck" ]];then
    defconfig_target="rvck_defconfig"
elif [[ "${REPO}" == "rvck-olk" ]];then
    defconfig_target="openeuler_defconfig"
elif [[ "${REPO}" == "linux" ]];then
    defconfig_target="defconfig"
elif [[ "${REPO}" == "openruyi-linux" ]];then
    defconfig_target="defconfig"
else
    echo "kernel_config未匹配到有效信息"
    exit 1
fi

# clone kernel repo
echo "[1/5] Clone kernel repo..."
TEMP_DIR=$(mktemp -d)
pushd ${TEMP_DIR}

git init .
git config user.email rvci@isrc.iscas.ac.cn
git config user.name rvci
git remote add origin "${REPO_URL}"
retry 10 30 git fetch origin "$fetch_ref":"$fetch_ref" --depth=1
git checkout $fetch_ref

git_commit=$(git rev-parse HEAD)
work_path=$(pwd)
popd

# build kernel via direct make(cross toolchain 已在容器构建时由
# manifest.scm 预装到镜像的 /gnu/store,镜像运行时 PATH 已包含
# riscv64-linux-gnu-*)
echo "[2/5] Configure kernel (defconfig)..."
pushd "${work_path}"
export CROSS_COMPILE=riscv64-linux-gnu-
export ARCH=riscv
make "${defconfig_target}"
popd

echo "[3/5] Build kernel (Image + modules + dtbs)..."
pushd "${work_path}"
make Image   -j"$(nproc)"
make modules -j"$(nproc)"
make dtbs    -j"$(nproc)"
popd

echo "[4/5] Install kernel artifacts..."
pushd "${work_path}"
mkdir -p "${RESULT_PATH}/${git_commit}/lib/dtb"

# 1) modules_install 把模块放到 ${RESULT_PATH}/${git_commit}/lib/modules/<kver>/...
make INSTALL_MOD_PATH="${RESULT_PATH}/${git_commit}" modules_install -j$(nproc)

# 2) 拷 vmlinux + Image 到 result 根
cp vmlinux                    "${RESULT_PATH}/${git_commit}/vmlinux"
cp arch/riscv/boot/Image      "${RESULT_PATH}/${git_commit}/Image"

# 3) 装 dtb(保留 vendor 子目录:lib/dtb/sifive/xxx.dtb、lib/dtb/starfive/xxx.dtb)
(cd arch/riscv/boot/dts && \
    find . -name '*.dtb' -exec install -m 644 -D {} "${RESULT_PATH}/${git_commit}/lib/dtb/{}" \;)
popd

# create modules archive
echo "[5/5] Create modules archive..."
module_path_name=$(ls ${RESULT_PATH}/${git_commit}/lib/modules/)
module_dir_name=$(basename "$module_path_name")
depmod -b ${RESULT_PATH}/${git_commit} "$module_dir_name"
# 压缩包内以 lib/modules/<kver>/ 相对路径存放,目标机
# `tar -xzf <kver>.tgz -C /` 落到标准内核模块路径
tar -czf  ${RESULT_PATH}/${git_commit}/"$module_dir_name".tgz -C ${RESULT_PATH}/${git_commit} lib/modules/"$module_dir_name"

echo ""
echo "=========================================="
echo "Build artifacts in ${RESULT_PATH}/${git_commit}:"
echo "=========================================="
ls -lh ${RESULT_PATH}/${git_commit}/
echo "[5/5] Done!"
