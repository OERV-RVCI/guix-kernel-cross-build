#!/bin/bash
set -e
URL=$1
RESULT_PATH=/srv/guix_result

URL_PROTOCOL="https://"
URL_WITHOUT_PROTOCOL=$(echo "$URL" | sed "s#^$URL_PROTOCOL##")
URL_DOMAIN=$(echo "$URL_WITHOUT_PROTOCOL" | cut -d '/' -f 1)
URL_PATH_PARTS=$(echo "$URL_WITHOUT_PROTOCOL" | cut -d '/' -f 2-)
URL_REPO_CORE=$(echo "$URL_PATH_PARTS" | cut -d '/' -f 1,2 | sed 's#/$##')
REPO=$(echo $URL_REPO_CORE | cut -d '/' -f 2 | sed 's/\.git$//')
REPO_URL="${URL_PROTOCOL}${URL_DOMAIN}/${URL_REPO_CORE}"
OS_ID=$(grep ^ID= /etc/os-release | cut -d'"' -f2)

retry() {
    local max_attempts=$1; shift
    local sleep_seconds=$1; shift
    local n=1

    while (( n <= max_attempts )); do
        if "$@"; then
            return 0
        fi
        echo "Attempt $n failed. Retrying in $sleep_seconds seconds..." >&2
        ((n++))
        sleep "$sleep_seconds"
    done

    echo "Command failed after $max_attempts attempts: $*" >&2
    return 1
}


if [[ "$URL" =~ /(pull)/([0-9]+) ]]; then
    echo "类型: ${BASH_REMATCH[1]}"
    echo "ID: ${BASH_REMATCH[2]}"
    fetch_ref="pull/${BASH_REMATCH[2]}/head"
elif [[ "$URL" =~ /(commit)/([0-9a-f]+) ]]; then
    echo "类型: ${BASH_REMATCH[1]}"
    echo "哈希值: ${BASH_REMATCH[2]}"
    fetch_ref="${BASH_REMATCH[2]}"
else
    echo "pull/commit未匹配到有效信息"
    exit 1
fi
if [[ "${REPO}" == "rvck" ]];then
    kernel_config="defconfig"
    dracut_driver_add=""
elif [[ "${REPO}" == "rvck-olk" ]];then
    kernel_config="openeuler_defconfig"
    dracut_driver_add="--add-drivers "k1-emac""
elif [[ "${REPO}" == "linux" ]];then
    kernel_config="defconfig"
    dracut_driver_add=""
else
    echo "kernel_config未匹配到有效信息"
    exit 1
fi

# clone kernel repo
echo "[1/8] Clone kernel repo..."
TEMP_DIR=$(mktemp -d)
pushd ${TEMP_DIR}

git init .
git config user.email rvci@isrc.iscas.ac.cn
git config user.name rvci
git remote add origin "${REPO_URL}"
retry 10 30 git fetch origin "$fetch_ref":"$fetch_ref" --depth=1
git checkout $fetch_ref

git_commit=$(git rev-parse HEAD)
work_path=$(pwd)
popd

# channels-lock.scm set guix version with commit, first download from substitute-urls, if substitute-urls download failed, then local build with guix source git repo
echo "Check guix channels config:"
cat /channels-lock.scm
echo ""

# calculate the kernel repo hash based on commitid
echo "[2/8] Calculate kernel repo hash..."
guix_download_log=${TEMP_DIR}/guix-download.log
{
    echo "=========================================="
    echo "GUIX DOWNLOAD LOG - START"
    echo "Repo: ${REPO}"
    echo "Commit: ${git_commit}"
    echo "Time: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "=========================================="
    retry 10 30 /entry-point.sh guix time-machine --substitute-urls=https://mirror.sjtu.edu.cn/guix -C /channels-lock.scm -- download --git file://${work_path} --commit=${git_commit} 2>&1
} > "${guix_download_log}"
guix_command_hash=$(tail -n +6 "${guix_download_log}")
repo_hash=$(echo ${guix_command_hash} | awk -F' ' '{print $2}')

if [ -z "${repo_hash}" ]; then
    echo "hash command error, download log:"
    tail -50 "${guix_download_log}"
    cat > guix-kernel-build.scm <<EOF
(use-modules (oerv packages rvck))
(make-linux-rvck
  #:name "linux-rvck"
  #:defconfig "${kernel_config}"
  #:commit "${git_commit}"
  #:url "file://${work_path}"
EOF
else
    cat > guix-kernel-build.scm <<EOF
(use-modules (oerv packages rvck))
(make-linux-rvck
  #:name "linux-rvck"
  #:defconfig "${kernel_config}"
  #:commit "${git_commit}"
  #:url "file://${work_path}"
  #:hash "${repo_hash}")
EOF
fi

cat guix-kernel-build.scm

# build kernel
echo "[3/8] Build kernel..."
guix_build_all_log=${TEMP_DIR}/guix-build-all.log
{
    echo "=========================================="
    echo "GUIX BUILD LOG - START"
    echo "Repo: ${REPO}"
    echo "Commit: ${git_commit}"
    echo "Kernel Config: ${kernel_config}"
    echo "Time: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "=========================================="
} > "${guix_build_all_log}"

set +e
/entry-point.sh guix time-machine --substitute-urls=https://mirror.sjtu.edu.cn/guix -C /channels-lock.scm -- build -f guix-kernel-build.scm --substitute-urls=https://mirror.sjtu.edu.cn/guix --target=riscv64-linux-gnu -r ${TEMP_DIR}/${git_commit} >> "${guix_build_all_log}" 2>&1
build_ret=${PIPESTATUS[0]}
set -e

if [ $build_ret -ne 0 ]; then
    echo ""
    echo "=========================================="
    echo "Build failed with exit code: $build_ret"
    echo "=========================================="
    echo ""
    echo "Last phase logs (from 'starting phase build'):"
    echo ""
    last_phase=$(grep -n "^starting phase" "${guix_build_all_log}" | tail -1 | cut -d: -f1)
    sed -n "${last_phase},$ p" "${guix_build_all_log}"
    echo ""
    echo "Cleaning up old dir and saving logs..."
    [ -d ${RESULT_PATH}/${git_commit} ] && rm -fr ${RESULT_PATH}/${git_commit}
    mkdir -p ${RESULT_PATH}/${git_commit}
    cp ${guix_download_log} ${guix_build_all_log} ${RESULT_PATH}/${git_commit}/
    exit $build_ret
fi 
if [ -L ${TEMP_DIR}/${git_commit} ] && [ -d ${TEMP_DIR}/${git_commit} ];then
    echo "Kernel result dir: ${TEMP_DIR}/${git_commit}"
    if [ -f ${TEMP_DIR}/${git_commit}/Image ];then
        echo "Kernel result file: ${TEMP_DIR}/${git_commit}/Image"
    else
        echo "Error: ${TEMP_DIR}/${git_commit}/Image not found"
        exit 1 
    fi
else
    echo "Error: ${TEMP_DIR}/${git_commit} not found"
    exit 1
fi
if [ -d ${RESULT_PATH}/${git_commit} ];then
    rm -fr ${RESULT_PATH}/${git_commit}
fi

# copy result from guix result link
echo "[4/8] Copy result..."
mkdir -p ${RESULT_PATH}/${git_commit}
cp ${guix_download_log} ${guix_build_all_log} ${RESULT_PATH}/${git_commit}/
rsync -a ${TEMP_DIR}/${git_commit}/ ${RESULT_PATH}/${git_commit}/

# create modules archive
echo "[5/8] Create modules archive..."
module_path_name=$(ls ${RESULT_PATH}/${git_commit}/lib/modules/)
module_dir_name=$(basename "$module_path_name")
depmod -b ${RESULT_PATH}/${git_commit} "$module_dir_name"
tar -czf  ${RESULT_PATH}/${git_commit}/"$module_dir_name".tgz -C ${RESULT_PATH}/${git_commit}/lib/modules/ "$module_dir_name"

set +e

# create initramfs
echo "[6/8] Create initramfs..."
initramfs_chroot=$(mktemp -d)
mkdir -p ${initramfs_chroot}/dev ${initramfs_chroot}/proc ${initramfs_chroot}/sys ${initramfs_chroot}/run
mount --bind /dev ${initramfs_chroot}/dev
mount --bind /dev/pts ${initramfs_chroot}/dev/pts
mount --bind /dev/shm ${initramfs_chroot}/dev/shm
mount --bind /run ${initramfs_chroot}/run
mount -t proc proc ${initramfs_chroot}/proc
mount -t sysfs sys ${initramfs_chroot}/sys

if [[ ${OS_ID} == "openEuler" ]]; then
    mkdir -p ${initramfs_chroot}/etc/yum.repos.d
    if [[ "${REPO}" == "rvck" ]]; then
        rva_repo_url="https://fast-mirror.isrc.ac.cn/openeuler/openEuler-24.03-LTS-SP3/everything/riscv64/rva20/riscv64/"
        rva_repo_id="Base-rva20"
    elif [[ "${REPO}" == "rvck-olk" ]]; then
        rva_repo_url="https://fast-mirror.isrc.ac.cn/openeuler/openEuler-24.03-LTS-SP3/everything/riscv64/rva23/riscv64/"
        rva_repo_id="Base-rva23"
    else
        echo "Error: unsupported REPO '${REPO}' for openEuler"
        exit 1
    fi
    cat > ${initramfs_chroot}/etc/yum.repos.d/openEuler-${rva_repo_id}.repo <<EOF
[${rva_repo_id}]
name=openEuler ${rva_repo_id}
baseurl=${rva_repo_url}
enabled=1
gpgcheck=0
EOF
    retry 10 30 dnf group install -y --disablerepo=* --enablerepo=${rva_repo_id} --forcearch riscv64 --installroot ${initramfs_chroot} --releasever=openEuler-24.03-LTS-SP3 --exclude=*kernel* "Minimal Install"
    retry 10 30 dnf install -y --disablerepo=* --enablerepo=${rva_repo_id} --forcearch riscv64 --installroot ${initramfs_chroot} --releasever=openEuler-24.03-LTS-SP3 dracut dracut-network nfs-utils
elif [[ ${OS_ID} == "openruyi" ]]; then
    mkdir -p ${initramfs_chroot}/etc/yum.repos.d
    cat > ${initramfs_chroot}/etc/yum.repos.d/openruyi-rva23.repo <<EOF
[Base-rva23]
name=openruyi Base rva23
baseurl=https://boat.openruyi.cn/unstable/rva23/
enabled=1
gpgcheck=0
EOF
    retry 10 30 dnf install -y --disablerepo=* --enablerepo=Base-rva23 --forcearch riscv64 --installroot ${initramfs_chroot} --exclude=*kernel* openruyi-minimal dracut systemd-networkd nfs-client
else
    echo "Error: wrong OS_ID"
    exit 1
fi

rsync -a ${RESULT_PATH}/${git_commit}/lib/modules/${module_dir_name} ${initramfs_chroot}/lib/modules/
chroot ${initramfs_chroot} /bin/bash -c "dracut /root/initramfs.img --no-hostonly --add \" nfs network base \" ${dracut_driver_add} --kver ${module_dir_name} && md5sum /root/initramfs.img > /root/initramfs.img.md5sum"
md5sum ${RESULT_PATH}/${git_commit}/Image > ${RESULT_PATH}/${git_commit}/Image.md5sum
cp ${initramfs_chroot}/root/initramfs.img* ${RESULT_PATH}/${git_commit}/
chmod 0644 ${RESULT_PATH}/${git_commit}/initramfs.img

# Unmount filesystems if they exist
echo "[7/8] Cleanup..."
if [ -d "${initramfs_chroot}/dev/pts" ]; then
    umount ${initramfs_chroot}/dev/pts 2>/dev/null || true
fi
if [ -d "${initramfs_chroot}/dev/shm" ]; then
    umount ${initramfs_chroot}/dev/shm 2>/dev/null || true
fi
if [ -d "${initramfs_chroot}/dev" ]; then
    umount ${initramfs_chroot}/dev 2>/dev/null || true
fi
if [ -d "${initramfs_chroot}/proc" ]; then
    umount ${initramfs_chroot}/proc 2>/dev/null || true
fi
if [ -d "${initramfs_chroot}/sys" ]; then
    umount ${initramfs_chroot}/sys 2>/dev/null || true
fi
if [ -d "${initramfs_chroot}/run" ]; then
    umount ${initramfs_chroot}/run 2>/dev/null || true
fi

echo ""
echo "=========================================="
echo "Build artifacts in ${RESULT_PATH}/${git_commit}:"
echo "=========================================="
ls -lh ${RESULT_PATH}/${git_commit}/
echo "[8/8] Done!"
